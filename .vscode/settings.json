{
  "css.validate": false, //告訴 VSCode 不要用內建 CSS 檢查器（避免標錯 @tailwind）
  "editor.formatOnSave": true, //儲存檔案時自動格式化（會觸發 Prettier 排版）
  "editor.defaultFormatter": "esbenp.prettier-vscode", //指定用 Prettier 套件來當作預設的 formatter（避免 VS Code 用別的）
  /* 搭配 Prettier - Code formatter套件  儲存自動格式化 */

  "tailwindCSS.experimental.classRegex": [
    ["class:\\s*\"([^\"]*)", 1],
    ["class:\\s*'([^']*)", 1],
    ["class:\\s*`([^`]*)", 1]
  ]
}
